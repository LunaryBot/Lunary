{
  "extends": "../../configs/tsconfig/base.json",

  "compilerOptions": {
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist",

    "noEmit": false,
    "removeComments": true,

    "allowJs": true,

    "typeRoots": [
      "./src/@types",
      "../../node_modules/@types"
    ],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,

    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    }
  },

  "include": ["src"],

  "exclude": [
    "dist",
    "node_modules"
  ]
}