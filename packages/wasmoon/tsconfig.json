{
    "compilerOptions": {
        "incremental": false,
        "inlineSources": false,
        "removeComments": false,
        "sourceMap": false,
        "target": "ES2018",
        "skipLibCheck": true,
        "lib": [
            "ESNEXT",
            "DOM"
        ],
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "importHelpers": true,
        "strict": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "emscripten"
        ],
    },
    "include": [
        "src/**/*",
        "test/**/*",
        "bench/**/*",
        "eslint.config.js"
    ],
    "exclude": [
        "node_modules"
    ]
}
